BACKEND_PORT=8000
SQLALCHEMY_DATABASE_URI=postgresql://oos_detection:oos_detection_dev_password@db:5432/oos_detection
# ─────────────────────────────────────────────────────────────────────────────
# Out-of-Stock Detection — Backend Environment Template
#
# Copy to backend/.env and fill in the values you need.
# setup.sh does this for you automatically during local dev.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
# development | production
FLASK_ENV=development

# URL the frontend is served from — used for CORS.
# Local dev default matches compose.dev.yml.
FRONTEND_URL=http://localhost:5173

# Self-referencing URL used in outbound email links.
SERVER_API_URL=http://localhost:8000

# Secret key for signing JWT / session tokens.
# REQUIRED in production — generate a fresh one:
#   python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=dev-secret-key-change-in-production

# ── Database ──────────────────────────────────────────────────────────────────

#   Requires: bash scripts/setup.sh --no-docker
#   Note: email/SMS alerts still work; shelf analysis still works.


# ── Email Alerts (Gmail) ──────────────────────────────────────────────────────
# Both fields must be set for email/SMS alerts to work.
# Leave commented out to disable alerting (the rest of the app still works).
#
# How to get an App Password:
#   1. Enable 2-FA on your Google account
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create a password for "Mail"
#   4. Paste the 16-character key below (spaces are fine)
#
# GMAIL_ADDRESS=you@gmail.com
# GMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# ── Phone Carrier Lookup (NumVerify / IPQS) ───────────────────────────────────
# Used in the invitation flow to show carrier-specific setup instructions.
# Free plan: 100 lookups/month — sign up at https://numverify.com
# Leave commented out to skip carrier detection (invitations still send).
#
# IPQS_API_KEY=

# ── ML Pipeline — Qwen VL SKU Identification ─────────────────────────────────
# Controls whether and how many product crops Qwen2-VL labels per image.
#
#   0     → YOLO detection + gap analysis only. No model download (~0 extra GB).
#           Recommended for machines with < 8 GB RAM or metered connections.
#   5     → Label only the top 5 detected crops (good middle ground).
#   all   → Label every detected product. Requires 4–16 GB RAM depending on
#           which Qwen variant auto-selects (2B-Instruct vs 7B-Instruct).
#
# First request with a non-zero value downloads the model from Hugging Face.
# Use HF_HOME to redirect the cache (see ARC workflow in README).
#

MAX_SKU_IDENTIFICATIONS=all
SKU_IDENTIFICATION_CHUNK_SIZE=4
# GPU mode — HF/Ultralytics cache paths (container's appuser has no writable HOME)
HF_HOME=/usr/src/app/.cache/huggingface
HF_HUB_CACHE=/usr/src/app/.cache/huggingface/hub
HF_DATASETS_CACHE=/usr/src/app/.cache/huggingface/datasets
TRANSFORMERS_CACHE=/usr/src/app/.cache/huggingface/hub
YOLO_CONFIG_DIR=/usr/src/app/.cache/ultralytics
