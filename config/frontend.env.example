# ─────────────────────────────────────────────────────────────────────────────
# Out-of-Stock Detection — Frontend Environment Template
#
# Copy to frontend/.env and set the URL where the backend is reachable.
# setup.sh does this for you automatically during local dev.
# ─────────────────────────────────────────────────────────────────────────────

# URL the React app uses to reach the Flask API.
# Local Docker dev:  http://localhost:8000  (or whatever port you chose)
# Production:        https://api.yourdomain.com
VITE_BACKEND_URL=http://localhost:8000

# How long (ms) the frontend waits for a shelf-analysis response.
# Qwen VL on CPU can take 2–5 minutes; raise this if requests time out.
# Default: 300000 (5 min). Set lower (e.g. 30000) when Qwen is disabled.
# VITE_SHELF_ANALYSIS_TIMEOUT_MS=300000
