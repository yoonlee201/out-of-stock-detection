SQLALCHEMY_DATABASE_URI=postgresql://oos_detection:oos_detection_dev_password@db:5432/oos_detection

# Gmail — App Password:
#    - Go to https://myaccount.google.com/apppasswords
#    - Generate a password for "Mail"
#    - Paste the 16-char password into GMAIL_PASSWORD below

# GMAIL_ADDRESS=
# GMAIL_PASSWORD=

# -- This is for getting carrier information for phone numbers, used in the invitation flow to provide better instructions to users. --
# NumVerify free API key (100 free lookups/month):
#    - Sign up at https://numverify.com (free plan, no credit card)
#    - Copy your API key into IPQS_API_KEY below
# IPQS_API_KEY=

# Set to 0 to skip Qwen SKU identification (YOLO + gap detection only, no model download)
# Set to a number (e.g. 3) to limit how many crops Qwen processes per image
# Leave unset or "all" to identify every detected product
MAX_SKU_IDENTIFICATIONS=0
SKU_IDENTIFICATION_CHUNK_SIZE=4